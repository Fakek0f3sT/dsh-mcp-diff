{
  "name": "dsh-mcp-diff",
  "version": "0.5.0",
  "description": "Diff cards in the DeepSeek Harness web chat for every file mutation — MCP filesystem calls (edit_file, write_file), built-in edit/write, and file-mutating bash commands (heredoc replaces, sed -i, cat/tee/redirect writes).",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx src/client/parse-bash.test.ts && node --import tsx src/client/parse-diff.test.ts",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fakek0f3sT/dsh-mcp-diff.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.1-rc.2",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsdown": "^0.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  }
}
